# Copy this file to .env and fill in the values for your local environment.
# Never commit real secrets, API keys, or database credentials.

# PostgreSQL connection string used by the backend database layer.
# Example: postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_microblog

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
